rules_version = '2';

// قواعد حماية قاعدة البيانات لبرنامج سجل قراءات المقطرات.
// تنلصق في: Firebase ← Firestore Database ← Rules ← Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    // حساب المشرف
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'admin@dcr-log.example';
    }
    // حسابات الشفتات A, B, C, D, F في DCR 1: من 1a إلى 1f
    function isDcr1() {
      return signedIn() && request.auth.token.email.matches('1[abcdf]@dcr-log[.]example');
    }
    // حسابات الشفتات A, B, C, D, F في DCR 2: من 2a إلى 2f
    function isDcr2() {
      return signedIn() && request.auth.token.email.matches('2[abcdf]@dcr-log[.]example');
    }
    function known() {
      return isAdmin() || isDcr1() || isDcr2();
    }
    // الورقتين 0 و 1 حق DCR 1 (D1A إلى D4B)، والورقتين 2 و 3 حق DCR 2 (D5A إلى D8B)
    function mayWrite(g) {
      return isAdmin() || (isDcr1() && g <= 1) || (isDcr2() && g >= 2);
    }

    // ---------- جدول الشفتات 2026 (محطة الدوحة الغربية) ----------
    // M من 7:00 إلى 15:00، A من 15:00 إلى 23:00، N من 23:00 إلى 7:00 بتوقيت الكويت.
    // دورة 5 أيام (M, A, N, OFF, OFF) تبدأ 15-01-2026 (اليوم رقم 20468 من 1970).
    // نفس الجدول موجود في index.html.

    // الدقايق من 1970 بتوقيت الكويت، والعد يبدا الساعة 7:00 (أول فترة M)
    function shiftMin(ms) {
      return int(math.floor((ms + 10800000) / 60000)) - 420;
    }
    // 0 = M، 1 = A، 2 = N
    function periodAt(m) {
      return int(math.floor((m % 1440) / 480));
    }
    // حرف الشفت اللي على الدوام بهالدقيقة
    function dutyAt(m) {
      let i = (int(math.floor(m / 1440)) - 20468 + 5000) % 5;
      // M: d a c b f، A: f d a c b، N: b f d a c (قائمة وحدة، لأن Firebase ما يقبل قائمة داخل قائمة هني)
      return ['d', 'a', 'c', 'b', 'f', 'f', 'd', 'a', 'c', 'b', 'b', 'f', 'd', 'a', 'c'][periodAt(m) * 5 + i];
    }
    // الشفت الداخل هو اللي على الدوام
    function onDuty(m) {
      return request.auth.token.email.matches('[12]' + dutyAt(m) + '@dcr-log[.]example');
    }
    // تاريخ الورقة لهالدوام (اليوم اللي بدا مع فترة M)، مثل 2026-11-18
    function dayRe(m) {
      let t = timestamp.value(int(math.floor(m / 1440)) * 86400000 + 32400000);
      return string(t.year()) + '-0?' + string(t.month()) + '-0?' + string(t.day());
    }
    // أوقات القراءة لفترة الدوام
    function slotsAt(m) {
      let s = ['0800', '1200', '1600', '2000', '0100', '0500'];
      let p = periodAt(m);
      return [s[p * 2], s[p * 2 + 1]];
    }
    function unitsOf(g) {
      let u = ['D1A', 'D1B', 'D2A', 'D2B', 'D3A', 'D3B', 'D4A', 'D4B', 'D5A', 'D5B', 'D6A', 'D6B', 'D7A', 'D7B', 'D8A', 'D8B'];
      let k = int(g) * 4;
      return [u[k], u[k + 1], u[k + 2], u[k + 3]];
    }
    // الشفت يغير ورقة اليوم بس، وبس قراءات فترة دوامه
    // before: القراءات قبل التعديل ({} لما الورقة جديدة)
    function sheetOk(m, before) {
      let units = unitsOf(request.resource.data.g);
      let slots = slotsAt(m);
      let after = request.resource.data.get('u', {});
      return onDuty(m)
        && request.resource.data.date.matches(dayRe(m))
        && after.diff(before).affectedKeys().hasOnly(units)
        && after.get(units[0], {}).diff(before.get(units[0], {})).affectedKeys().hasOnly(slots)
        && after.get(units[1], {}).diff(before.get(units[1], {})).affectedKeys().hasOnly(slots)
        && after.get(units[2], {}).diff(before.get(units[2], {})).affectedKeys().hasOnly(slots)
        && after.get(units[3], {}).diff(before.get(units[3], {})).affectedKeys().hasOnly(slots);
    }
    // ضغطة "حفظ" من الشفت اللي على الدوام، لقسمه ولوقت من فترته
    function stampOk(m) {
      let d = request.resource.data;
      return onDuty(m)
        && d.date.matches(dayRe(m))
        && d.slot in slotsAt(m)
        && request.auth.token.email == d.by + '@dcr-log.example'
        && d.by == string(d.dcr) + d.s.lower();
    }
    // الدقيقة الحين. وفيه 10 دقايق بعد نهاية الدوام بس عشان القراءة اللي انحفظت آخر لحظة أو بدون نت توصل.
    function nowMin() {
      return shiftMin(request.time.toMillis());
    }

    // ورقة القراءات: مستند لكل تاريخ ولكل ورقة (4 مقطرات)، اسمه مثل 2026-11-11_1
    function sheetValid(id) {
      return request.resource.data.g is int
        && request.resource.data.g >= 0
        && request.resource.data.g <= 3
        && mayWrite(request.resource.data.g)
        && request.resource.data.date is string
        && request.resource.data.month is string
        && id == request.resource.data.date + '_' + string(request.resource.data.g);
    }
    match /sheets/{id} {
      allow read: if known();
      allow create: if sheetValid(id)
        && (isAdmin() || sheetOk(nowMin(), {}) || sheetOk(nowMin() - 10, {}));
      allow update: if sheetValid(id)
        && (isAdmin() || sheetOk(nowMin(), resource.data.get('u', {})) || sheetOk(nowMin() - 10, resource.data.get('u', {})));
      allow delete: if isAdmin();
    }

    // وقت ضغط "حفظ" على آخر مقطرة: الشفت يضيف بس، والمشرف بس يشوف
    match /stamps/{id} {
      allow read: if isAdmin();
      allow create: if (isDcr1() || isDcr2())
        && request.resource.data.keys().hasOnly(['date', 'month', 'dcr', 'slot', 's', 'by', 'at'])
        && request.resource.data.date is string
        && request.resource.data.month is string
        && request.resource.data.dcr in [1, 2]
        && request.resource.data.s in ['A', 'B', 'C', 'D', 'F']
        && request.resource.data.slot is string
        && request.resource.data.by is string
        && request.resource.data.at == request.time
        && (stampOk(nowMin()) || stampOk(nowMin() - 10));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // إعدادات البرنامج: الكل يقراها، والمشرف بس يغيرها
    match /config/{id} {
      allow read: if known();
      allow write: if isAdmin();
    }
  }
}
