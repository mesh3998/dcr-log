rules_version = '2';

// قواعد حماية قاعدة البيانات لبرنامج سجل قراءات المقطرات.
// تنلصق في: Firebase ← Firestore Database ← Rules ← Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    // حساب المشرف
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'admin@dcr-log.example';
    }
    // حسابات الشفتات A, B, C, D, F
    function isShift() {
      return signedIn() && request.auth.token.email.matches('shift-[abcdf]@dcr-log[.]example');
    }
    function known() {
      return isAdmin() || isShift();
    }

    // ورقة القراءات: مستند لكل تاريخ ولكل ورقة (4 مقطرات)، اسمه مثل 2026-11-11_1
    match /sheets/{id} {
      allow read: if known();
      allow create, update: if known()
        && request.resource.data.date is string
        && request.resource.data.month is string
        && request.resource.data.g is int
        && request.resource.data.g >= 0
        && request.resource.data.g <= 3
        && id == request.resource.data.date + '_' + string(request.resource.data.g);
      allow delete: if isAdmin();
    }

    // مواعيد الشفتات: الكل يقراها، والمشرف بس يغيرها
    match /config/{id} {
      allow read: if known();
      allow write: if isAdmin();
    }
  }
}
